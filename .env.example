# Copy to .env and change the passwords.

# --- Web UI database connection ---
# Use DB_HOST=postgres with the bundled database (--profile db),
# or set it to your existing PostgreSQL server's address.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=idmEvent
DB_USER=eventlogger_reader
DB_PASSWORD=change_me_reader
TABLE_NAME=public.dxmlevent

# Host port for the web UI
WEB_PORT=5000

# --- Bundled PostgreSQL (only used with --profile db) ---
# Accounts are created on first start only; changing these later has no effect
# unless you delete the pgdata volume.
POSTGRES_PASSWORD=change_me_admin
WRITER_USER=eventlogger_writer
WRITER_PASSWORD=change_me_writer
# Host port the IDM driver connects to
POSTGRES_PORT=5432
