# Copy to .env and replace every change_me value. No real values belong in this file.

# Release to run: the web UI image and the engine jars are taken from the same release.
EVENTLOGGER_VERSION=2.0.0

# --- Which database? ---
# Optional bundled PostgreSQL container: on by default. To use your own PostgreSQL
# instead, delete this line and set DB_HOST below to your server's address.
COMPOSE_PROFILES=db

# --- Web UI database connection ---
# DB_HOST=postgres means the bundled container; otherwise your server's address.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=idmEvent
DB_USER=eventlogger_reader
DB_PASSWORD=change_me_reader
TABLE_NAME=public.dxmlevent

# Host port for the web UI
WEB_PORT=5000

# --- Bundled PostgreSQL (only used when COMPOSE_PROFILES includes db) ---
# Accounts and the cleanup job are created on first start only; changing these later
# has no effect unless you delete the pgdata volume.
POSTGRES_PASSWORD=change_me_admin
WRITER_USER=eventlogger_writer
WRITER_PASSWORD=change_me_writer
# Host port the Identity Manager driver connects to
POSTGRES_PORT=5432
# Size-based cleanup (pg_cron): delete the oldest events when the table exceeds this size
EVENT_MAX_SIZE_MB=1000
# When to check, in cron syntax (UTC)
PURGE_SCHEDULE=0 4 * * *
